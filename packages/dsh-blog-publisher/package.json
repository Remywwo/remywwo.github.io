{
  "name": "@local/blog-publisher",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Publish Markdown blog posts from a DSH session to GitHub and open a pull request that triggers the site deployment",
  "license": "MIT",
  "exports": {
    ".": "./tools.js",
    "./operations": "./operations.js",
    "./config": "./config.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "main": "./tools.js",
  "files": [
    "config.js",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "locale/*.json",
    "operations.js",
    "tools.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5"
  }
}
